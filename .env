# ROS_IP is the IP of the machine running the docker container
# MOWER_IP is the IP of the Mower
# When not in ser2net mode, both ip should be the same
ROS_IP=192.0.0.2
MOWER_IP=10.0.0.161
IMAGE=ghcr.io/cedbossneo/mowgli-docker:upstream

# LD19 Lidar (optional - use docker-compose.lidar.yaml overlay)
# LIDAR_PORT=/dev/ttyUSB0
# LIDAR_TOPIC=/scan
# LIDAR_FRAME_ID=base_laser
# LIDAR_FIX_TF=true
# LIDAR_ODOM_ENABLE=false